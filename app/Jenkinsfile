// CI -> GitOps pipeline: test -> build -> security scan -> smoke test -> push to GHCR -> update manifest in Git
// ArgoCD then deploys the new image tag from Git.
pipeline {
    // LAB: the controller has the Docker CLI. In production: dedicated agents, 0 executors on the controller.
    agent { label 'built-in' }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(name: 'RUN_ON_AGENT', defaultValue: false,
                     description: 'Also run a stage on the SSH agent (label: linux)')
    }

    environment {
        IMAGE         = "ghcr.io/penchalj/lab-app:${env.BUILD_NUMBER}"
        APP_CONTAINER = "lab-app-${env.BUILD_NUMBER}"
    }


    stages {
        stage('Unit tests') {
            agent {
                docker { image 'python:3.12-slim'; reuseNode true }
            }
            steps {
                dir('app') {
                    sh 'python -m py_compile app.py'
                    sh 'python -m unittest -v'
                }
            }
        }

        stage('Build image') {
            steps {
                dir('app') {
                    //sh 'docker build --build-arg BUILDKIT_INLINE_CACHE=1 -t "$IMAGE" .'
                    sh 'docker build --pull -t "$IMAGE" .'

                }
            }
        }
        stage('Security scan') {
            agent {
                docker {
                    image 'aquasec/trivy:latest'
                    args  '--entrypoint= -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache'
                    reuseNode true
                }
            }
            steps {
                // 1. Secrets + dependency CVEs + misconfig in the source code (report only)
                sh 'trivy fs --scanners vuln,secret,misconfig --exit-code 0 --no-progress .'
                // 2. SBOM of the image - archived with the build
                sh 'trivy image --format cyclonedx --output sbom.cdx.json --no-progress "$IMAGE"'
                // 3. GATE: fail on HIGH/CRITICAL CVEs that have a fix
                sh 'trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --no-progress "$IMAGE"'
            }
            post {
                always { archiveArtifacts artifacts: 'sbom.cdx.json', allowEmptyArchive: true }
            }
        }

        stage('Smoke test') {
            steps {
                sh '''
                    docker run -d --name "$APP_CONTAINER" --network lab-net -e APP_VERSION="$BUILD_NUMBER" "$IMAGE"
                    for i in $(seq 1 10); do
                        if curl -fsS "http://$APP_CONTAINER:8000/health"; then
                            echo; echo "Smoke test passed"; exit 0
                        fi
                        sleep 1
                    done
                    echo "Smoke test FAILED"; docker logs "$APP_CONTAINER"; exit 1
                '''
            }
        }
        stage('Publish image') {
            // Push the tested, scanned image to GitHub Container Registry
            steps {
                withCredentials([usernamePassword(credentialsId: 'ghcr',
                                                  usernameVariable: 'REG_USER',
                                                  passwordVariable: 'REG_TOKEN')]) {
                    sh '''
                        echo "$REG_TOKEN" | docker login ghcr.io -u "$REG_USER" --password-stdin
                        docker push "$IMAGE"
                        docker logout ghcr.io
                    '''
                }
            }
        }

        stage('Update GitOps manifest') {
            // Write the new image tag into k8s/lab-app.yaml and push -> ArgoCD deploys it
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-push',
                                                  usernameVariable: 'GIT_USER',
                                                  passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        git config user.name  "Jenkins CI"
                        git config user.email "jenkins@lab.local"
                        git fetch origin main
                        git checkout -B main origin/main

                        sed -i "s|image: .*lab-app:.*|image: ghcr.io/penchalj/lab-app:${BUILD_NUMBER}|" k8s/lab-app.yaml
                        sed -i "/name: APP_VERSION/{n;s|value: .*|value: \\"${BUILD_NUMBER}\\"|}" k8s/lab-app.yaml
                        grep -A1 -E 'image:|APP_VERSION' k8s/lab-app.yaml

                        git add k8s/lab-app.yaml
                        git commit -m "Deploy lab-app:${BUILD_NUMBER} [skip ci]" || echo "Nothing to commit"
                        git push "https://${GIT_USER}:${GIT_TOKEN}@github.com/penchalj/devops-lab.git" main
                    '''
                }
            }
        }

        stage('Agent check') {
            when { expression { params.RUN_ON_AGENT } }
            agent { label 'linux' }
            steps {
                sh 'hostname; uname -a; java -version; df -h .'
            }
        }
    }

    post {
        always {
            sh 'docker rm -f "$APP_CONTAINER" >/dev/null 2>&1 || true'
        }
        success { echo "Built, scanned, pushed and deployed via GitOps: ${env.IMAGE}" }
        failure { echo 'Build failed - check the stage logs above' }
    }
}
